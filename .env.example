# Adaptive Learning Core - Environment Variables
# Copy this file to .env and fill in your values

# =============================================================================
# LLM Provider API Keys (Optional - only needed for LLM-based features)
# =============================================================================

# OpenAI API Key (for question generation, Bloom classification, LLM-as-judge)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Key (alternative LLM provider)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# =============================================================================
# Embedding Provider (Optional - for RAG-based question generation)
# =============================================================================

# If using OpenAI embeddings instead of local sentence-transformers
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# =============================================================================
# Development Settings
# =============================================================================

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# =============================================================================
# Notes
# =============================================================================
# - The HeuristicBloomClassifier works without any API keys (keyword-based)
# - IRT models, mastery algorithms, and card selection work fully offline
# - API keys are only needed for:
#   - BloomClassifier (LLM-based classification)
#   - QuestionGenerator (RAG-based question generation)
#   - LLMJudge (question quality evaluation)
#   - DistractorGenerator (generating wrong answer choices)
